{
  "name": "paper2-slot-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Paper 2 slot-machine experiment prototype. G0 scaffold only. No real participant data.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext .ts --ignore-pattern handoffs/** --ignore-pattern sources/**",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{ts,css,html,json}\" \"tests/**/*.ts\" \"config/**/*.{ts,json}\" \"docs/**/*.md\" \"handoffs/**/*.md\" \"*.{ts,cjs,mjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html,json}\" \"tests/**/*.ts\" \"config/**/*.{ts,json}\" \"docs/**/*.md\" \"handoffs/**/*.md\" \"*.{ts,cjs,mjs,json,md}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "build:server": "vite build --config vite.server.config.ts",
    "build:all": "npm run build && npm run build:server",
    "start:server": "node dist-server/main.js",
    "test:server": "vitest run tests/server",
    "swarm": "node tools/swarmctl.ts",
    "test:collection": "playwright test --config playwright.collection.config.ts",
    "collect:local": "node tools/collection-local.ts start",
    "collect:campus": "node tools/campus-local.ts",
    "collect:export": "node tools/collection-local.ts export",
    "collect:backup": "node tools/collection-local.ts backup"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "jspsych": "^7.3.4",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^24.13.6",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
